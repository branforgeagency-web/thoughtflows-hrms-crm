PORT=5001
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/thoughtflows_db
JWT_SECRET=thoughtflows_super_secret_jwt_key_2026
CLIENT_URL=http://localhost:5173

ZOOM_SDK_KEY=
ZOOM_SDK_SECRET=

ZOOM_ACCOUNT_ID=
ZOOM_S2S_CLIENT_ID=
ZOOM_S2S_CLIENT_SECRET=
ZOOM_HOST_EMAIL=
# Extra LICENSED Zoom users (comma-separated) handed out to trainers who have no
# Zoom email of their own, so several such classes can run at the same time.
ZOOM_HOST_POOL=
# Live meetings one Zoom user may host at once: 1 (Pro) or 2 (Business/Education/Enterprise)
ZOOM_MEETINGS_PER_HOST=1

BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Thoughtflows Academy

# ---- Telephony provider switch ----
# edesy (default) | knowlarity
TELEPHONY_PROVIDER=edesy

# ---- Edesy (Number Masking) click-to-call ----
# Bearer API key from masking.edesy.in > API Keys (NOT the Account SID/Auth Token pair
# on the dashboard's "API Credentials" panel — that's a different product).
EDESY_API_KEY=
EDESY_BASE_URL=https://voice-api.edesy.in/v1
EDESY_DEFAULT_AGENT_PHONE=
EDESY_MAX_CALL_DURATION_SEC=
EDESY_SESSION_EXPIRY_MINUTES=180
EDESY_WEBHOOK_SECRET=
EDESY_WEBHOOK_SIGNATURE_HEADER=x-edesy-signature

# ThoughtFlows Live Classroom (LiveKit) — replaces Zoom for trainer live classes.
# Create a project at cloud.livekit.io → Settings → Keys.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Animated PowerPoint slides (HTML5) — Aspose.Slides Cloud, https://dashboard.aspose.cloud → Applications
# Leave empty to keep the PowerPoint web viewer only.
ASPOSE_CLIENT_ID=
ASPOSE_CLIENT_SECRET=
# ASPOSE_API_BASE=https://api.aspose.cloud
