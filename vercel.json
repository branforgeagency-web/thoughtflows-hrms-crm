{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://thoughtflows-hrms-crm.onrender.com/api/:path*"
    },
    {
      "source": "/recordings/:path*",
      "destination": "https://thoughtflows-hrms-crm.onrender.com/recordings/:path*"
    },
    {
      "source": "/((?!api/|recordings/).*)",
      "destination": "/index.html"
    }
  ]
}
